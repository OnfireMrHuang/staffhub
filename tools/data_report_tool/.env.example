# 智擎版与旧版共用此应用。支持大小写；系统环境变量优先。
app_id=YOUR_APP_ID
app_secret=YOUR_APP_SECRET
auth_code=YOUR_AUTH_CODE

# 可选：直接使用已有 token，优先于本地缓存。
# access_token=

# 巨量千川使用独立应用，不能填入上面的营销应用凭据。
# 两套凭据可放在同一个 .env 中；千川也支持 QIANCHUAN_APP_ID 等大写名称。
qianchuan_app_id=YOUR_QIANCHUAN_APP_ID
qianchuan_app_secret=YOUR_QIANCHUAN_APP_SECRET
qianchuan_auth_code=YOUR_QIANCHUAN_AUTH_CODE
# qianchuan_access_token=
