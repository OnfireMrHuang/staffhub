# 人工登录或短信提醒时必填。已有有效导入会话且不发短信时可留空。
ZHONGAN_PHONE=
ZHONGAN_BROWSER_CHANNEL=chrome
ZHONGAN_DY_NO=37365205524
ZHONGAN_PLATFORM=DOUYIN
# 留空：每轮使用北京时间当天；复现示例时设置 2026-10-20。
ZHONGAN_DATE=

# 可选：暂未接入时只打印提醒，不会真实发送短信。
# POST {"phone":"...","event":"zhongan_login_expired","message":"..."}
# 网关必须返回 HTTP 2xx 及 {"success":true} 才视为成功。
ZHONGAN_SMS_GATEWAY_URL=
ZHONGAN_SMS_GATEWAY_TOKEN=
ZHONGAN_SMS_COOLDOWN_SECONDS=3600
