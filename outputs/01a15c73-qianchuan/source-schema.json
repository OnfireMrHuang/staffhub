{
  "title": "获取今日直播数据",
  "method": "GET",
  "path": "/open_api/v1.0/qianchuan/report/live/get/",
  "header": {
    "data": []
  },
  "request": {
    "data": [
      {
        "type": "number",
        "description": "客户id",
        "required": true,
        "format": "int64",
        "name": "advertiser_id",
        "label": [
          "必填"
        ]
      },
      {
        "type": "number",
        "description": "抖音号ID",
        "required": true,
        "format": "int64",
        "name": "aweme_id",
        "label": [
          "必填"
        ]
      },
      {
        "type": "string",
        "description": "直播开始时间，格式 2021-04-05 00:00:00 ，开播时间在筛选日期内的直播间，会被统计",
        "required": true,
        "name": "start_time",
        "label": [
          "必填"
        ]
      },
      {
        "type": "string",
        "description": "直播结束时间，格式 2021-04-05 23:59:59 ，开始时间同一天的23:59:59\n即：查询的是一天0点～24点的直播数据",
        "required": true,
        "name": "end_time",
        "label": [
          "必填"
        ]
      },
      {
        "type": "array",
        "description": "需要查询的消耗指标，具体可参考返回值",
        "required": true,
        "name": "fields",
        "label": [
          "必填"
        ],
        "children": [
          {
            "type": "string",
            "description": "",
            "required": false
          }
        ]
      },
      {
        "type": "string",
        "description": "需要查询的投放账户维度，直客账户支持查看官方抖音号下同主体全部投放账户的数据表现\n同主体账户： QUALIFICATION ，仅直客账户支持\n当前账户： CURRENT ，默认",
        "required": false,
        "name": "stats_authority",
        "enum": [
          {
            "key": "CURRENT",
            "description": "当前账户"
          },
          {
            "key": "QUALIFICATION",
            "description": "同主体账户，仅直客账户支持"
          }
        ]
      }
    ]
  },
